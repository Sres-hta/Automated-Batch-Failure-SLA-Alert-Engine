BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 366.5 Td (# Kahn's Algorithm in src/engine.py) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 355.0 Td (in_degree = {jid: 0 for jid in job_map}) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 343.5 Td (adj_list = {jid: [] for jid in job_map}) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 332.0 Td (for jid, job in job_map.items\(\):) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 320.5 Td (  for up in job.get\('depends_on', []\):) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 309.0 Td (    adj_list[up].append\(jid\)) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 297.5 Td (    in_degree[jid] += 1) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 286.0 Td (queue = [j for j, d in in_degree.items\(\)) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 274.5 Td (if d == 0]) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 263.0 Td (while queue:) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 251.5 Td (  curr = queue.pop\(0\)) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 240.0 Td (  ordered.append\(curr\)) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 228.5 Td (  for n in adj_list[curr]:) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 217.0 Td (    in_degree[n] -= 1) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 205.5 Td (    if in_degree[n] == 0:) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 194.0 Td (      queue.append\(n\)) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 182.5 Td (if len\(ordered\) != len\(job_map\):) Tj ET
BT /F4 8.0 Tf 0.85 0.92 1.0 rg 32.0 171.0 Td (  raise ValueError\('Cyclic dependency!'\)) Tj ET
